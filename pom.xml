<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.fliver</groupId>
  <artifactId>fliver-live-chat</artifactId>
  <version>0.1.5-beta</version>
  <packaging>jar</packaging>

  <name>Fliver Live Chat</name>
  <description>
    Paper plugin that relays Minecraft chat to a Discord channel and back in
    real time. Talks only to the Fliver Live Chat API (default
    https://fliver.net, see PROTOCOL.md) - never touches Discord directly and
    ships no Discord credentials of any kind. Shades Trio (net.fliver:trio)
    for config, language, and Folia-safe scheduling.
  </description>
  <url>https://github.com/Fliver-OSP/live-chat</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
  </properties>

  <repositories>
    <!-- paper-api isn't on Maven Central. -->
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <!-- Public Trio coordinates: net.fliver:trio -->
    <repository>
      <id>fliver</id>
      <url>https://fliver.net/maven</url>
    </repository>
  </repositories>

  <dependencies>
    <!--
      Compiled against 1.20.1 on purpose, not the newest Paper - this is the
      "legacy/broad support" floor: one jar built here keeps loading on every
      Paper release from 1.20 forward (api-version in plugin.yml is what
      makes that promise stick), as long as the code only touches API that's
      been stable since this floor. See README.md's "Supported versions".
    -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.20.1-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
    <!-- Foundation library: https://fliver.net/maven → net.fliver:trio -->
    <dependency>
      <groupId>net.fliver</groupId>
      <artifactId>trio</artifactId>
      <version>0.5.1-beta</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>Fliver-LiveChat-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
